# Fat Cat Fit — ตัวอย่างตัวแปรสภาพแวดล้อม
# คัดลอกเป็น .env.local แล้วแก้ค่า · ห้ามใส่ค่าจริงในไฟล์นี้ (repo เป็นสาธารณะ)
# ค่าด้านล่างเป็นค่าปลอมที่ตั้งใจให้ดูออกว่าไม่ใช่ของจริง
# บรรทัดที่ขึ้นต้นด้วย # = ไม่ตั้งก็ได้ในเครื่อง dev (ตั้งเมื่อจะลองฟีเจอร์นั้น) หรือโค้ดยังไม่อ่าน (ระบุไว้ในบรรทัดอธิบาย)
# ขั้นตอนตั้งค่าบน Vercel/Neon: docs/OPERATIONS.md

# ---- ใช้แล้วใน R0 ------------------------------------------------------------

# Connection string ของ Neon แบบ pooled (hostname มี -pooler) · ใช้ตอนแอปรัน · งาน dev/preview ใช้ชุด dev เท่านั้น
DATABASE_URL=postgresql://<user>:<password>@<pooled-host>/<dbname>?sslmode=require

# Connection string แบบ direct (ไม่มี -pooler) · ใช้ตอนรัน migration (npm run db:migrate / drizzle-kit)
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<direct-host>/<dbname>?sslmode=require

# ข้อความสุ่มยาวอย่างน้อย 32 ตัวอักษรสำหรับ Better Auth · ต้องต่างกันทุกสภาพแวดล้อม · สร้างด้วย: openssl rand -base64 32
BETTER_AUTH_SECRET=<random-string-at-least-32-chars>

# บน Vercel Production เท่านั้น: ตั้งเป็น 1 เพื่อให้ build รัน migration ก่อน deploy (scripts/release-migrate.ts) · ไม่ตั้ง = ไม่รัน
# MIGRATE_ON_DEPLOY=1

# ---- ใช้ตั้งแต่ R1 -----------------------------------------------------------

# URL เต็มของแต่ละสภาพแวดล้อม เช่น http://localhost:3000 · Preview ต้องตั้งเป็น URL ของ preview นั้น (ไม่ตั้ง = redirect_uri_mismatch / ลิงก์ผิดโดเมน)
# BETTER_AUTH_URL=http://localhost:3000

# OAuth client ของ Google (boss สร้างใน Google Cloud Console) · ไม่ตั้ง = ปุ่ม Google ใช้ไม่ได้ แต่แอปไม่ล่ม
# GOOGLE_CLIENT_ID=<google-oauth-client-id>
# GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>

# วิธีส่งอีเมล OTP: smtp | log · ไม่ตั้ง = log นอก production (พิมพ์รหัสลง console ของเครื่อง ไม่ส่งจริง) · production ต้องตั้งเอง
# EMAIL_TRANSPORT=log

# ชื่อ + ที่อยู่ผู้ส่ง (ต้องใช้เมื่อ EMAIL_TRANSPORT=smtp) · สลับเป็นโดเมนของเราได้โดยแก้ตัวแปรนี้กับ SMTP_* เท่านั้น
# EMAIL_FROM=Fat Cat Fit <noreply@example.com>

# SMTP (ต้องใช้เมื่อ EMAIL_TRANSPORT=smtp) · Gmail ของแอป: smtp.gmail.com พอร์ต 465 (SSL) หรือ 587 (STARTTLS) · SMTP_PASS คือ app password ไม่ใช่รหัสผ่านบัญชี
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=<smtp-user>
# SMTP_PASS=<smtp-app-password>

# เพดานจำนวนอีเมล OTP ต่อวัน (ค่าเริ่ม 400 · Gmail จำกัด 500/วัน)
# OTP_DAILY_CAP=400

# ยังไม่มีโค้ดอ่านในรอบนี้ (ใช้เมื่อมี cron ในรอบหลัง): ความลับที่ใช้ตรวจว่าคำขอ /api/cron/* มาจาก cron ของ Vercel จริง
# CRON_SECRET=<random-string-at-least-16-chars>

# เฉพาะสคริปต์ทดสอบออฟไลน์ของ pwa-offline (src/pwa/e2e) — ไม่ใช้ในแอป: ช่องทางเบราว์เซอร์ของ Playwright เช่น chrome
S5_CHANNEL=chrome

# เฉพาะสคริปต์สร้าง sprite ของแมว (scripts/sprites/build.mjs) — ไม่ใช้ในแอป: path ของ Chrome/Edge ถ้าไม่ได้อยู่ที่ตำแหน่งมาตรฐาน
CHROME=

# เฉพาะ E2E ของ qa-test (playwright.config.ts) — ไม่ใช้ในแอป · ไม่ตั้ง = ค่าเริ่มต้นในวงเล็บ
# E2E_PORT=3110              (พอร์ตของ next start ที่เทสต์เปิดเอง)
# E2E_CHANNEL=chrome         (ไม่ตั้ง: เครื่องนักพัฒนาใช้ Chrome ที่ติดตั้ง · CI ใช้ Chromium ของ Playwright)
# E2E_SKIP_BUILD=1           (ข้าม npm run build เมื่อเพิ่ง build ไปแล้ว)

# เฉพาะสคริปต์ spike A4 (scripts/spike-a4.ts) — ไม่ใช้ในแอป: URL ของ preview + อีเมลทดสอบ (ใช้ @example.com ในเอกสาร) · SPIKE_COUNT/SPIKE_GAP_MS ปรับจำนวนครั้ง/ช่วงเว้น (ค่าเริ่ม 20 / 125000)
# SPIKE_BASE_URL=https://preview.example.com
# SPIKE_EMAIL=tester@example.com
# SPIKE_COUNT=20
# SPIKE_GAP_MS=125000
