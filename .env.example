# Fat Cat Fit — ตัวอย่างตัวแปรสภาพแวดล้อม
# คัดลอกเป็น .env.local แล้วแก้ค่า · ห้ามใส่ค่าจริงในไฟล์นี้ (repo เป็นสาธารณะ)
# ค่าด้านล่างเป็นค่าปลอมที่ตั้งใจให้ดูออกว่าไม่ใช่ของจริง
# บรรทัดที่ขึ้นต้นด้วย # = ยังไม่มีโค้ดอ่านตัวแปรนี้ในรอบปัจจุบัน (ใช้ตั้งแต่รอบที่ระบุ)
# ขั้นตอนตั้งค่าบน Vercel/Neon: docs/OPERATIONS.md

# ---- ใช้แล้วใน R0 ------------------------------------------------------------

# Connection string ของ Neon แบบ pooled (hostname มี -pooler) · ใช้ตอนแอปรัน · งาน dev/preview ใช้ชุด dev เท่านั้น
DATABASE_URL=postgresql://<user>:<password>@<pooled-host>/<dbname>?sslmode=require

# Connection string แบบ direct (ไม่มี -pooler) · ใช้ตอนรัน migration (npm run db:migrate / drizzle-kit)
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<direct-host>/<dbname>?sslmode=require

# ข้อความสุ่มยาวอย่างน้อย 32 ตัวอักษรสำหรับ Better Auth · ต้องต่างกันทุกสภาพแวดล้อม · สร้างด้วย: openssl rand -base64 32
BETTER_AUTH_SECRET=<random-string-at-least-32-chars>

# บน Vercel Production เท่านั้น: ตั้งเป็น 1 เพื่อให้ build รัน migration ก่อน deploy (scripts/release-migrate.ts) · ไม่ตั้ง = ไม่รัน
# MIGRATE_ON_DEPLOY=1

# ---- ใช้ตั้งแต่ R1 -----------------------------------------------------------

# URL เต็มของแต่ละสภาพแวดล้อม เช่น http://localhost:3000 (ไม่ตั้ง = redirect_uri_mismatch)
# BETTER_AUTH_URL=http://localhost:3000

# OAuth client ของ Google (boss สร้างใน Google Cloud Console)
# GOOGLE_CLIENT_ID=<google-oauth-client-id>
# GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>

# วิธีส่งอีเมล OTP: smtp | log | http · เครื่อง dev และ preview ใช้ log (พิมพ์รหัสลง console ของเครื่อง ไม่ส่งจริง)
# EMAIL_TRANSPORT=log

# ชื่อ + ที่อยู่ผู้ส่ง · สลับเป็นโดเมนของเราได้โดยแก้ตัวแปรนี้กับ SMTP_* เท่านั้น
# EMAIL_FROM=Fat Cat Fit <noreply@example.com>

# SMTP ของ Gmail ของแอป (SMTP_PASS คือ app password ไม่ใช่รหัสผ่านบัญชี) · host/port ยืนยันจากเอกสาร Google ก่อนตั้ง
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=<smtp-user>
# SMTP_PASS=<smtp-app-password>

# เพดานจำนวนอีเมล OTP ต่อวัน (ค่าเริ่ม 400)
# OTP_DAILY_CAP=400

# ความลับที่ใช้ตรวจว่าคำขอ /api/cron/* มาจาก cron ของ Vercel จริง
# CRON_SECRET=<random-string-at-least-16-chars>

# ชื่อ header ที่ Vercel ใช้ส่ง IP ของผู้ใช้ (ใช้จำกัดจำนวนครั้ง) · security-privacy ยืนยันชื่อใน R1
# TRUSTED_IP_HEADER=<header-name>
